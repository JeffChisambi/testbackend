# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/gtms_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Access token: short-lived (15m recommended)
JWT_SECRET=change-me-to-a-secure-32-char-minimum-secret
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token: long-lived (7d recommended)
JWT_REFRESH_SECRET=change-me-to-a-different-32-char-minimum-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── File Uploads ────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ─── Email (Optional) ────────────────────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
